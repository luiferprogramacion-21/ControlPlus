@host = http://localhost:8080
@masterKey = replace-locally-never-commit-the-real-master-key
@adminUser = admin.local
@adminPassword = replace-locally-never-commit-the-real-password
@token = paste-the-access-token-returned-by-login
@categoryId = paste-a-category-id-returned-by-the-api
@measurementUnitId = paste-a-measurement-unit-id-returned-by-the-api
@productId = paste-a-product-id-returned-by-the-api
@cashShiftId = paste-the-open-shift-id-returned-by-the-api
@cashConfigurationVersion = paste-the-configuration-version-returned-by-cash-state
@cashShiftVersion = paste-the-shift-version-returned-by-reconciliation
@cashPaymentMethodId = paste-a-payment-method-id-returned-by-reconciliation
@cashDifferenceReasonId = paste-an-active-cash-difference-reason-id
@operatorUserId = paste-an-operator-user-id
@operatorCredentialToken = paste-the-token-returned-once-when-issued
@operatorSessionId = paste-the-operator-session-id
@authorizerUser = paste-a-different-supervisor-or-administrator-user-name
@authorizerPassword = paste-the-authorizer-password-locally

### Instalación inicial (solo funciona mientras no exista ningún usuario)
POST {{host}}/api/auth/setup
Content-Type: application/json
X-ControlPlus-Master-Key: {{masterKey}}

{
  "establishmentName": "Nombre local del establecimiento",
  "establishmentIdentification": "IDENTIFICACION-LOCAL",
  "installationCode": "INSTALACION-LOCAL",
  "installationSerial": "SERIE00001",
  "terminalCode": "TERMINAL-01",
  "terminalName": "Terminal principal",
  "userName": "{{adminUser}}",
  "displayName": "Administrador local",
  "password": "{{adminPassword}}"
}

### Inicio de sesión
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "userName": "{{adminUser}}",
  "password": "{{adminPassword}}"
}

### Recuperación excepcional del Administrador inicial
# Solo cuando no exista ningún Administrador activo y no bloqueado.
POST {{host}}/api/auth/recover-initial-administrator
Content-Type: application/json
X-ControlPlus-Master-Key: {{masterKey}}

{
  "userName": "{{adminUser}}",
  "newPassword": "{{adminPassword}}"
}

### Usuario autenticado
GET {{host}}/api/auth/me
Authorization: Bearer {{token}}

### Usuarios
GET {{host}}/api/users?page=1&pageSize=20
Authorization: Bearer {{token}}

### Roles
GET {{host}}/api/roles?page=1&pageSize=20
Authorization: Bearer {{token}}

### Permisos
GET {{host}}/api/permissions?page=1&pageSize=50
Authorization: Bearer {{token}}

### Auditoría
GET {{host}}/api/audit-records?page=1&pageSize=100
Authorization: Bearer {{token}}

### Categorías activas
GET {{host}}/api/categories?page=1&pageSize=20
Authorization: Bearer {{token}}

### Crear categoría
POST {{host}}/api/categories
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Categoría local",
  "description": null
}

### Unidades de medida
GET {{host}}/api/measurement-units
Authorization: Bearer {{token}}

### Productos disponibles (oculta agotados)
GET {{host}}/api/products?page=1&pageSize=20
Authorization: Bearer {{token}}

### Buscar producto (incluye agotados)
GET {{host}}/api/products?search=CODIGO-LOCAL&page=1&pageSize=20
Authorization: Bearer {{token}}

### Crear producto con código de barras generado
POST {{host}}/api/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "categoryId": "{{categoryId}}",
  "measurementUnitId": "{{measurementUnitId}}",
  "supplierId": null,
  "internalCode": "CODIGO-LOCAL",
  "barcode": null,
  "barcodeFormat": null,
  "generateBarcode": true,
  "name": "Producto local",
  "description": null,
  "retailPrice": 0,
  "wholesalePrice": null,
  "taxPercentage": null,
  "minimumStock": 0
}

### Consultar producto
GET {{host}}/api/products/{{productId}}
Authorization: Bearer {{token}}

### Historial oficial de costos de compra (requiere PRODUCTS.COSTS_READ)
GET {{host}}/api/products/{{productId}}/purchase-cost-history?page=1&pageSize=20
Authorization: Bearer {{token}}

### Estado de la caja
# CASH.OWN_READ solo expone estado general y datos propios; un turno ajeno queda oculto.
GET {{host}}/api/cash/state
Authorization: Bearer {{token}}

### Configurar la caja (una sola vez; requiere CONFIGURATION.MANAGE)
POST {{host}}/api/cash/register
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "CODIGO-REAL-LOCAL",
  "name": "NOMBRE-REAL-LOCAL"
}

### Configurar modalidad (INDIVIDUAL o COMPARTIDO; no puede haber turno abierto)
PUT {{host}}/api/cash/shift-mode
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "mode": "INDIVIDUAL",
  "version": {{cashConfigurationVersion}}
}

### Abrir turno
POST {{host}}/api/cash/shifts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "initialAmount": 0,
  "observations": null
}

### Consultar movimientos del turno abierto
GET {{host}}/api/cash/movements?page=1&pageSize=50
Authorization: Bearer {{token}}

### Registrar ingreso manual
POST {{host}}/api/cash/movements/incomes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": 1000,
  "concept": "Reemplace localmente por el concepto real",
  "operatorSessionId": null
}

### Registrar gasto
POST {{host}}/api/cash/movements/expenses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": 1000,
  "concept": "Reemplace localmente por el concepto real",
  "operatorSessionId": null
}

### Registrar sangría
POST {{host}}/api/cash/movements/cash-drops
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "amount": 1000,
  "concept": "Reemplace localmente por el concepto real",
  "operatorSessionId": null
}

### Consultar arqueo esperado
# cashDifference = efectivo contado - esperado; totalDifference = total contado - total esperado.
# Los pagos distribuyen el esperado por medio; sus movimientos vinculados no se suman otra vez.
GET {{host}}/api/cash/reconciliation
Authorization: Bearer {{token}}

### Cerrar turno (incluya exactamente todos los medios devueltos por reconciliation)
# Conteos enteros dentro de numeric(18,0); electrónicos admiten netos negativos, efectivo no.
# La autorización depende de totalDifference != 0. No envíe IDs de autorizaciones anteriores.
# El detalle confirmado es inmutable; las diferencias compensadas no requieren autorización.
POST {{host}}/api/cash/shifts/{{cashShiftId}}/close
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "version": {{cashShiftVersion}},
  "paymentMethods": [
    {
      "paymentMethodId": "{{cashPaymentMethodId}}",
      "countedAmount": 0
    }
  ],
  "differenceReasonId": null,
  "differenceObservation": null,
  "authorization": null
}

### Emitir credencial Code128 para turno compartido
# El token solo se entrega en esta respuesta y no debe guardarse en el repositorio.
POST {{host}}/api/cash/operator-credentials/{{operatorUserId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "expiresAtUtc": null
}

### Iniciar sesión de operador compartido
POST {{host}}/api/cash/operator-sessions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "credentialToken": "{{operatorCredentialToken}}"
}

### Finalizar sesión de operador compartido
POST {{host}}/api/cash/operator-sessions/{{operatorSessionId}}/close
Authorization: Bearer {{token}}

### Ejemplo estructural de cierre con diferencia
# diferencia conserva solo efectivo; diferencia_total conserva el total. Signo: contado menos esperado.
# Use únicamente identificadores, valores y credenciales reales de su entorno local.
POST {{host}}/api/cash/shifts/{{cashShiftId}}/close
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "version": {{cashShiftVersion}},
  "paymentMethods": [
    {
      "paymentMethodId": "{{cashPaymentMethodId}}",
      "countedAmount": 0
    }
  ],
  "differenceReasonId": "{{cashDifferenceReasonId}}",
  "differenceObservation": "Reemplace localmente por la observación real",
  "authorization": {
    "userName": "{{authorizerUser}}",
    "password": "{{authorizerPassword}}"
  }
}
