<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ControlPlus.Infrastructure\ControlPlus.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\LocalPostgresDatabase.cs" Link="LocalPostgresDatabase.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\scripts\admin-self-authorization\*.sql"
             Link="admin-self-authorization\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
